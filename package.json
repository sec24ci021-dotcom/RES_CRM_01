{
    "name": "lead-management-module",
    "version": "1.0.0",
    "description": "Smart Real Estate CRM - Lead Management Module",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "dev:clean": "node scripts/cleanStart.js",
        "init-db": "node sample-data/initDatabase.js",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.js\"",
        "seed": "node sample-data/initDatabase.js"
    },
    "keywords": [
        "real-estate",
        "crm",
        "lead-management",
        "mongodb",
        "express",
        "nodejs"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "mongoose": "^7.0.0",
        "dotenv": "^16.0.3",
        "cors": "^2.8.5",
        "morgan": "^1.10.0",
        "jsonwebtoken": "^9.0.0",
        "bcryptjs": "^2.4.3",
        "joi": "^17.9.1",
        "helmet": "^7.0.0",
        "express-rate-limit": "^6.7.0"
    },
    "devDependencies": {
        "nodemon": "^2.0.20",
        "jest": "^29.5.0",
        "supertest": "^6.3.3",
        "eslint": "^8.40.0",
        "prettier": "^2.8.8",
        "@faker-js/faker": "^8.0.1"
    },
    "engines": {
        "node": ">=14.0.0",
        "npm": ">=6.0.0"
    },
    "nodemonConfig": {
        "ignore": [
            "node_modules",
            "logs",
            "*.log",
            "scripts",
            "thunder-collection-leads.json",
            "thunder-env.json"
        ],
        "delay": 500
    }
}