# Frontend Environment Configuration
# Local development - API connection settings

# API Base URL - Points to backend server
VITE_API_BASE_URL=http://localhost:3002/api/v1

# Environment
VITE_ENV=development

# Debug mode
VITE_DEBUG=true

# Request timeout (milliseconds)
VITE_REQUEST_TIMEOUT=30000

# Application name
VITE_APP_NAME=Lead Management System
