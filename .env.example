# Environment Configuration Template
# Copy this file to .env and update with your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
API_VERSION=v1

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb://localhost:27017/lead-crm
MONGODB_USER=admin
MONGODB_PASSWORD=password
MONGODB_AUTHSOURCE=admin
MONGODB_REPLICA_SET=

# MongoDB Atlas Connection (alternative)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/lead-crm?retryWrites=true&w=majority

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM=noreply@leadcrm.com
EMAIL_FROM_NAME=Lead CRM
EMAIL_ENCRYPTION=tls

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs
LOG_FILE=app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# ============================================
# PAGINATION CONFIGURATION
# ============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
MIN_PAGE_SIZE=1

# ============================================
# SECURITY CONFIGURATION
# ============================================
BCRYPT_ROUNDS=10
SESSION_SECRET=your_session_secret_key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CACHE CONFIGURATION (Optional)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
CACHE_ENABLED=true

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png
UPLOAD_DIR=./uploads

# ============================================
# TIMEZONE
# ============================================
TZ=Asia/Kolkata
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_ANALYTICS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_AUDIT_LOGGING=true
ENABLE_SOFT_DELETE=true

# ============================================
# API CONFIGURATION
# ============================================
API_TIMEOUT=30000
API_RETRIES=3
API_RETRY_DELAY=1000

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * 
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups

# ============================================
# MONITORING & DEBUGGING
# ============================================
DEBUG=false
SENTRY_DSN=
NEWRELIC_LICENSE_KEY=
ANALYTICS_ENABLED=false

# ============================================
# ENVIRONMENT SPECIFIC
# ============================================
ENVIRONMENT=development
APP_NAME=Lead CRM
APP_VERSION=1.0.0

# For Production (uncomment and modify)
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://user:pass@production-cluster.mongodb.net/lead-crm
# JWT_SECRET=production_jwt_secret_key_here
# ENABLE_EMAIL_NOTIFICATIONS=true
# ENABLE_SMS_NOTIFICATIONS=true
