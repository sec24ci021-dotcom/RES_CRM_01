{
    "info": {
        "_postman_id": "lead-management-api-collection",
        "name": "Lead Management API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "description": "Postman collection for Lead Management System (Auth, Leads CRUD, Search, Filter, Assignment, Status)"
    },
    "variable": [
        { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
        { "key": "accessToken", "value": "" },
        { "key": "refreshToken", "value": "" },
        { "key": "leadId", "value": "" },
        { "key": "assigneeId", "value": "" }
    ],
    "item": [{
            "name": "Auth",
            "item": [{
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Alice Admin\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Secret123!\",\n  \"role\": \"Admin\"\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
                    },
                    "response": [{
                        "name": "201 Created",
                        "originalRequest": {},
                        "status": "Created",
                        "code": 201,
                        "_body": "{\n  \"success\": true,\n  \"message\": \"User registered successfully\",\n  \"data\": {\n    \"_id\": \"60f6c9f1e1a2b40012a3b456\",\n    \"name\": \"Alice Admin\",\n    \"email\": \"alice@example.com\",\n    \"role\": \"Admin\"\n  }\n}"
                    }]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Secret123!\"\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
                    },
                    "response": [{
                        "name": "200 OK",
                        "status": "OK",
                        "code": 200,
                        "_body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"user\": { \"id\": \"60f6c9f1e1a2b40012a3b456\", \"name\": \"Alice Admin\", \"email\": \"alice@example.com\", \"role\": \"Admin\" },\n    \"token\": \"<JWT_ACCESS_TOKEN>\",\n    \"refreshToken\": \"<JWT_REFRESH_TOKEN>\"\n  }\n}"
                    }]
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{ \"refreshToken\": \"<JWT_REFRESH_TOKEN>\" }" },
                        "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
                    },
                    "response": []
                },
                {
                    "name": "Me (current user)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
                    },
                    "response": [{
                        "name": "200 OK",
                        "status": "OK",
                        "code": 200,
                        "_body": "{\n  \"success\": true,\n  \"message\": \"Current user\",\n  \"data\": { \"userId\": \"60f6c9f1e1a2b40012a3b456\", \"email\": \"alice@example.com\", \"role\": \"Admin\" }\n}"
                    }]
                }
            ]
        },
        {
            "name": "Leads",
            "item": [{
                    "name": "List Leads",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "url": { "raw": "{{baseUrl}}/leads?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["leads"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
                    },
                    "response": []
                },
                {
                    "name": "Create Lead",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bob Buyer\",\n  \"email\": \"bob@example.com\",\n  \"phone\": \"+1234567890\",\n  \"source\": \"website\"\n}" },
                        "url": { "raw": "{{baseUrl}}/leads", "host": ["{{baseUrl}}"], "path": ["leads"] }
                    },
                    "response": [{
                        "name": "201 Created",
                        "status": "Created",
                        "code": 201,
                        "_body": "{\n  \"success\": true,\n  \"message\": \"Lead created successfully\",\n  \"data\": { \"_id\": \"LEAD_ID_123\", \"name\": \"Bob Buyer\", \"email\": \"bob@example.com\" }\n}"
                    }]
                },
                {
                    "name": "Get Lead by ID",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "url": { "raw": "{{baseUrl}}/leads/{{leadId}}", "host": ["{{baseUrl}}"], "path": ["leads", "{{leadId}}"] }
                    },
                    "response": []
                },
                {
                    "name": "Update Lead",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "body": { "mode": "raw", "raw": "{ \"phone\": \"+1987654321\", \"status\": \"contacted\" }" },
                        "url": { "raw": "{{baseUrl}}/leads/{{leadId}}", "host": ["{{baseUrl}}"], "path": ["leads", "{{leadId}}"] }
                    },
                    "response": []
                },
                {
                    "name": "Delete Lead",
                    "request": {
                        "method": "DELETE",
                        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "url": { "raw": "{{baseUrl}}/leads/{{leadId}}", "host": ["{{baseUrl}}"], "path": ["leads", "{{leadId}}"] }
                    },
                    "response": []
                },
                {
                    "name": "Search Leads (query)",
                    "request": {
                        "method": "GET",
                        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "url": { "raw": "{{baseUrl}}/leads/search?q=bob", "host": ["{{baseUrl}}"], "path": ["leads", "search"], "query": [{ "key": "q", "value": "bob" }] }
                    },
                    "response": []
                },
                {
                    "name": "Filter Leads (body)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "body": { "mode": "raw", "raw": "{\n  \"status\": \"new\",\n  \"source\": \"website\",\n  \"assignedTo\": \"{{assigneeId}}\"\n}" },
                        "url": { "raw": "{{baseUrl}}/leads/filter", "host": ["{{baseUrl}}"], "path": ["leads", "filter"] }
                    },
                    "response": []
                },
                {
                    "name": "Assign Lead",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "body": { "mode": "raw", "raw": "{ \"assigneeId\": \"{{assigneeId}}\" }" },
                        "url": { "raw": "{{baseUrl}}/leads/{{leadId}}/assign", "host": ["{{baseUrl}}"], "path": ["leads", "{{leadId}}", "assign"] }
                    },
                    "response": [{ "name": "200 OK", "status": "OK", "code": 200 }]
                },
                {
                    "name": "Change Status",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
                        "body": { "mode": "raw", "raw": "{ \"status\": \"qualified\" }" },
                        "url": { "raw": "{{baseUrl}}/leads/{{leadId}}/status", "host": ["{{baseUrl}}"], "path": ["leads", "{{leadId}}", "status"] }
                    },
                    "response": [{ "name": "200 OK", "status": "OK", "code": 200 }]
                }
            ]
        }
    ]
}